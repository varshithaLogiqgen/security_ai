DJANGO_DEBUG=true
SYNTHETIC_MODE=true
LOCAL_AUTH_ENABLED=true
FRONTEND_URL=http://127.0.0.1:5174
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
SCANNER_MODE=synthetic
